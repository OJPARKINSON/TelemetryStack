# Ingest config tuned for running on the 7600X sending to telemetry-service on a Pi 5
# Copy to .env and adjust as needed

SERVER_URL=localhost

# Worker count - 7600X has 6C/12T, default formula gives ~7-8, this matches that
WORKER_COUNT=8
FILE_QUEUE_SIZE=5000
WORKER_TIMEOUT=45m

# Batch tuning - larger batches reduce HTTP round-trips to the Pi
# 16k records / 32MB is a good balance; don't go much higher or the Pi's ILP path stalls
BATCH_SIZE_RECORDS=16000
BATCH_SIZE_BYTES=33554432
BATCH_TIMEOUT=50ms

# File processing
FILE_PROCESS_TIMEOUT=10m
FILE_AGE_THRESHOLD=30s

# Retry behaviour - Pi can be briefly slow under WAL apply, give it a bit more room
MAX_RETRIES=5
RETRY_DELAY=500ms

# Go runtime - let the 7600X use its cores freely
GOGC=200

# Profiling (off by default)
ENABLE_PPROF=false
PPROF_PORT=6060
MEMORY_TUNING=false
