{
	"name": "dashboard",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --port 3000",
		"build": "tsc -b && vite build",
		"test:build": "tsc --noEmit",
		"serve": "vite preview",
		"lint": "biome check --write"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		}
	},
	"dependencies": {
		"@tailwindcss/postcss": "^4.3.2",
		"@tailwindcss/vite": "^4.3.2",
		"@tanstack/react-router": "^1.170.17",
		"@types/geojson": "^7946.0.16",
		"autoprefixer": "^10.5.2",
		"clsx": "^2.1.1",
		"lucide-react": "^1.24.0",
		"maplibre-gl": "^6.11.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"recharts": "^3.9.2",
		"swr": "^2.4.2",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@tanstack/router-plugin": "^1.168.23",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.3",
		"postcss": "^8.5.16",
		"tailwindcss": "^4.3.2",
		"typescript": "^7",
		"vite": "^8.1.4",
		"vite-plugin-compression2": "^2.5.3"
	},
	"engines": {
		"node": ">=18.0.0",
		"npm": ">=9.0.0"
	},
	"browserslist": {
		"production": [
			">0.3%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"overrides": {
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	}
}
